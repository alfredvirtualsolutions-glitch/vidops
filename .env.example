# Mureka AI music generation
MUREKA_API_KEY=
MUREKA_API_URL=https://api.mureka.ai/v1/generate

# Local GPU video generation (requires: make install-gpu)
VIDEO_GEN_LOCAL_ENABLED=true
VIDEO_GEN_LOCAL_MODEL=wan2.2-ti2v-5b
# Alternatives: wan2.1-1.3b, wan2.1-14b, hunyuan-1.5, ltx2-local, cogvideo-5b

# Google Gemini API Key (copy to .env and set your key)
GEMINI_API_KEY=

# Braintrust Tracing (optional)
BRAINTRUST_API_KEY=